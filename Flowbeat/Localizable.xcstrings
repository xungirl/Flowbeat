    "A bit distracted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有点分心"
          }
        }
      }
    },
    "A focus session runs a Mind & Body workout to read your heart rate. It is discarded and never saved to Health.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注时会启动一个「身心」类体能训练来读取心率；结束时丢弃，不会存进「健康」。"
          }
        }
      }
    },
    "A gentle tap on your wrist when you have been distracted for a while. Never while you walk, calibrate or take a break.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走神一阵子时，手腕上轻轻震一下。走路、校准和休息时不会提醒。"
          }
        }
      }
    },
    "AI is watching…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在观察…"
          }
        }
      }
    },
    "AI judge is on: every 2 minutes a summary of your heart rate and motion is sent to the backend configured in this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 判断已开启：每 2 分钟把心率和动作的统计摘要发到这个版本里配置的后端。"
          }
        }
      }
    },
    "AI offline · %lld queued": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 离线 · 排队 %lld 条"
          }
        }
      }
    },
    "AI review": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
