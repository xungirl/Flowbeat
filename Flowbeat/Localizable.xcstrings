    "Estimates how focused you are from your heart rate and wrist motion, as a 0–100 score.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据心率和手腕动作，估计你有多专注，给出 0–100 的专注指数。"
          }
        }
      }
    },
