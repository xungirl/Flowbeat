    "Minutes with a focus score of 70 or more. The daily goal sets your streak.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按专注指数 ≥ 70 的分钟数计算。每日目标决定连续达标天数。"
          }
        }
      }
    },
    "Motion & Fitness is off, so walking won't pause scoring. Settings → Privacy & Security → Motion & Fitness.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「运动与健身」已关闭，走动时不会自动暂停。设置 → 隐私与安全性 → 运动与健身。"
          }
        }
      }
    },
    "Motion & Fitness, to pause while you walk": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动与健身：走动时自动暂停"
          }
        }
      }
    },
    "Needs 10+ scored minutes in one hour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一小时内需要 10 分钟以上的数据"
          }
        }
      }
    },
