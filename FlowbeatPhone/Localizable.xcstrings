    "Sessions are stored only on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注记录只保存在这台 iPhone 上。"
          }
        }
      }
    },
    "Sessions from your Apple Watch appear here after you end them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 上结束专注后，记录会出现在这里。"
          }
        }
      }
    },
    "Sessions sync to your private iCloud database, so a new iPhone gets them back. Only your Apple Account can read them. Turn it off in iOS Settings → your name → iCloud.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注记录同步到你的 iCloud 私有数据库，换新 iPhone 也能找回，只有你的 Apple 账户能读取。可以在 iOS 设置 → 你的名字 → iCloud 中关闭。"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Start a focus session in Flowbeat on your Apple Watch. When you end it, the session appears here with its focus timeline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 上的心流里开始一次专注。结束后，这次专注和它的专注时间线会出现在这里。"
          }
        }
      }
    },
