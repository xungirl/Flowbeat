    "Flowbeat estimates focus from heart rate and wrist motion. The score is an estimate, not a measurement, and it isn't a medical device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心流根据心率和手腕动作估计专注程度。分数是估计值，不是测量结果，本 app 也不是医疗器械。"
          }
        }
      }
    },
    "Flowbeat isn't installed on your Apple Watch yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表上还没装心流"
          }
        }
      }
    },
