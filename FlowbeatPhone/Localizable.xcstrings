    "It's removed from this iPhone and from iCloud. The copy on your watch isn't sent again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会从这台 iPhone 和 iCloud 中删除。手表上的那份不会再传过来。"
          }
        }
      }
    },
    "Labels: Focused / Distracted taps on the watch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签：你在手表上点的「专注 / 走神」次数。"
          }
        }
      }
    },
