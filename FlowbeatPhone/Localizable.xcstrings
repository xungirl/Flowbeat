        }
      }
    },
    "Minutes with a focus score of 70 or more. The daily goal sets your streak and syncs with your watch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注分数 ≥ 70 的分钟数。每日目标决定连续达标天数，并和手表同步。"
          }
        }
      }
    },
    "No account, no tracking, no ads. Sessions never leave your devices except through your own iCloud.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，不追踪，没有广告。专注记录只会通过你自己的 iCloud 离开你的设备。"
          }
        }
      }
    },
